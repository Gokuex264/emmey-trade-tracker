# ── Emmey Trade Tracker — environment variables ──
# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and will NEVER be pushed to GitHub.

# PostgreSQL connection string from Supabase (Connect → Session pooler / URI).
# Remember to replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Secret used to sign login sessions. Set this to any long random string.
emmey_trade_tracker=change-me-to-a-long-random-string

# (Optional) Anthropic API key — only needed for the AI chat feature.
ANTHROPIC_API_KEY=

# (Optional) Admin panel password for the /admin page.
ADMIN_PASSWORD=

# (Optional) Port the server listens on. Defaults to 3000.
PORT=3000
